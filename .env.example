# Dominio público del sitio (sin barra final).
# De él dependen la URL canónica, sitemap.xml, robots.txt y las imágenes de Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.raicescare.earth

# API institucional (NestJS). Sin esta variable el sitio funciona igual:
# simplemente no se envían los eventos de CTA.
# Local: http://localhost:3001
NEXT_PUBLIC_API_URL=
